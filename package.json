{
  "name": "workflow",
  "private": true,
  "version": "0.1.0",
  "description": "WORKFLOW — asisten produktivitas kerja pribadi (monorepo Turborepo + pnpm).",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @workflow/database prisma:generate",
    "db:migrate": "pnpm --filter @workflow/database prisma:migrate",
    "db:seed": "pnpm --filter @workflow/database prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  }
}
